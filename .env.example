# Copy to .env.local. Everything is optional: without Supabase the site stores RSVPs and
# blessings in the guest's browser (fine for previews and for collecting RSVPs by phone).

# Public URL of the deployed invite (used for Open Graph / WhatsApp previews)
NEXT_PUBLIC_SITE_URL=https://simran-arjun.example.com

# Supabase (recommended): run supabase/schema.sql in the SQL editor first
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
